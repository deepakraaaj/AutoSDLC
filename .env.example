# Fallback only, used until a provider is picked from the UI (gear icon next
# to "Provider: x" in the sidebar) — that choice is persisted in the database
# and takes precedence over this. Groq, Cerebras, and Gemini are selectable
# from the UI; Ollama/LM Studio/HuggingFace are env-var-only.
# Options: groq | gemini | cerebras | ollama | lmstudio | huggingface
AI_PROVIDER=groq

# Runtime safety mode. Production hides internal exception detail and rejects
# insecure/private Redmine destinations unless explicitly overridden.
ENVIRONMENT=development
# Localhost/private Redmine is enabled automatically in development and denied
# automatically in production. Set true in production only for a deliberate,
# network-controlled on-prem Redmine deployment.
# ALLOW_PRIVATE_REDMINE_URLS=false

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cerebras (1M tokens/day free tier) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- LM Studio (local, no API key needed) ---
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=google/gemma-4-e4b

# --- Ollama (self-hosted) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Redmine Integration ---
REDMINE_URL=https://your-redmine.example.com
REDMINE_API_KEY=your_api_key_here
REDMINE_PROJECT_ID=your_project_identifier
REDMINE_EPIC_TRACKER_ID=Epic
REDMINE_STORY_TRACKER_ID=Story
REDMINE_TASK_TRACKER_ID=Task

# --- Generation engine ---
# legacy = hand-written GenerationPipeline (app/services/generators.py, default).
# langgraph = LangGraph-orchestrated equivalent (app/services/langgraph_pipeline.py).
GENERATION_ENGINE=legacy

# --- Bitbucket Integration ---
# Three credential shapes work here (bitbucket/client.py's BitbucketConfig).
# In order of what's actually likely to work for you:
#  1. App Password (RECOMMENDED — free on every plan, reliable). Bitbucket ->
#     avatar -> Personal Bitbucket settings -> App passwords -> Create.
#     Check only Repositories: Read and Pull requests: Read. Set
#     BITBUCKET_USERNAME to your Bitbucket username (not your email) and
#     BITBUCKET_ACCESS_TOKEN to the generated app password.
#  2. Bitbucket repository/workspace access token — Bearer auth, no
#     BITBUCKET_USERNAME needed. Requires a paid Bitbucket plan
#     (Premium/Standard); a Free workspace can't generate these at all.
#  3. Atlassian account API token (id.atlassian.com/manage-profile/security/
#     api-tokens), with BITBUCKET_USERNAME set to your Atlassian account
#     email. Works only if the token was created with Bitbucket-specific
#     scoping — inconsistent enough that (1) is the safer default.
# Scope whichever you use to Read-only unless you specifically want this app
# writing to Bitbucket — but scoping the token is only the first layer.
# BITBUCKET_ALLOW_WRITES below is the app's own hard kill switch, and it's
# the one that actually matters: every write call in this codebase
# (post_pr_comment, create_bitbucket_issue, and push_backlog_to_bitbucket
# which calls the latter — see bitbucket/client.py's
# _require_writes_allowed) refuses to even attempt the request unless this
# is exactly "true", regardless of what token scope, UI confirmation flag,
# or per-project setting a caller further up passed. Leave it unset/false
# and nothing this app does can ever write to Bitbucket, full stop.
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=your-repo
BITBUCKET_ACCESS_TOKEN=your_app_password_or_access_token
# BITBUCKET_USERNAME=your-bitbucket-username   # App Password or Atlassian API token — not needed for a Bitbucket access token
# ALLOW_PRIVATE_BITBUCKET_URLS=false
# BITBUCKET_ALLOW_WRITES=true   # UNSET/false by default — read-only until you explicitly opt in

# --- Bitbucket webhook (inbound) ---
# POST /webhooks/bitbucket is UNSAFE/INERT without this set — a missing
# secret means every delivery is rejected (fail-closed), not accepted
# unsigned. Set this to the same value configured on the Bitbucket repo's
# webhook (Repository settings -> Webhooks -> Secret).
BITBUCKET_WEBHOOK_SECRET=set_a_long_random_secret_here
